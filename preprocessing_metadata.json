        "diff_srv_rate",
        "dst_host_count",
        "dst_host_srv_count",
        "dst_host_same_srv_rate",
        "dst_host_serror_rate",
        "num_failed_logins",
        "logged_in",
        "protocol_type_ICMP",
        "protocol_type_TCP",
        "protocol_type_UDP",
        "service_DNS",
        "service_FTP",
        "service_HTTP",
        "service_HTTPS",
        "service_SSH"
